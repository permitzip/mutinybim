{
  "name": "mutinybim",
  "version": "0.2.0",
  "private": true,
  "description": "MutinyBIM: an open, agent-first, real-time multi-user building model for every AEC trade.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/permitzip/mutinybim.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "demo": "node --import tsx packages/bim-devserver/src/server.ts",
    "web": "TSX_TSCONFIG_PATH=apps/mutinybim-web/tsconfig.runtime.json node --import tsx apps/mutinybim-web/src/server.ts",
    "web:reset-password": "TSX_TSCONFIG_PATH=apps/mutinybim-web/tsconfig.runtime.json node --import tsx apps/mutinybim-web/src/admin.ts reset-password",
    "test": "jest",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc -p packages/tsconfig.bim.json",
    "typecheck:authority": "cd services/bim-authority && tsc -p tsconfig.json",
    "lint": "eslint packages services/bim-authority/src apps && node eslint/plugins/mutinybim-oss-boundary-licenses.mjs",
    "example": "node packages/bim-mcp/bin/mutinybim-example.mjs",
    "mutinybim-script": "node packages/bim-script/bin/mutinybim-script.mjs",
    "mcp": "node packages/bim-mcp/bin/mutinybim-mcp.mjs",
    "mcp:http": "node packages/bim-mcp/bin/mutinybim-mcp.mjs --http --port 3333",
    "mcp:all": "node packages/bim-mcp/bin/mutinybim-mcp.mjs --http --port 3333 --packs all",
    "licenses": "node tools/licenses/dependency-licenses.mjs",
    "licenses:write": "node tools/licenses/dependency-licenses.mjs --write",
    "perf:bim": "node --import tsx scripts/perf/mutinybim/run.ts",
    "perf:bim:ci": "node --import tsx scripts/perf/mutinybim/run.ts --self-test && node --import tsx scripts/perf/mutinybim/run.ts --ci",
    "perf:suites": "node tools/perf/run-perf-suites.cjs",
    "proof-packs": "bash scripts/bim/check-proof-pack-commits.sh",
    "release:version": "node tools/release/set-version.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-virtual": "3.14.9",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@thatopen/fragments": "3.4.8",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.33.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "babel-plugin-jest-hoist": "30.4.0",
    "camera-controls": "3.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lucide-react": "0.577.0",
    "manifold-3d": "3.5.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "postcss": "8.5.23",
    "qrcode-terminal": "0.12.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-pdf": "10.4.1",
    "recharts": "2.15.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "web-ifc": "0.0.78",
    "ws": "8.21.3",
    "zod": "4.6.7"
  }
}
